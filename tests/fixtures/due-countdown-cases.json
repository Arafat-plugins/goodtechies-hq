{
    "about": "One set of cases read by tests/js/dueCountdown.test.ts (the Board card's countdown label) and tests/Feature/Tasks/DueCountdownAgreementTest.php (the server's isOverdue / scopeOverdue). A date-only due date is owed until the END of that day in the app time zone, i.e. 00:00 of the next day there. `now` carries its own offset; `expected.label` null means the card renders nothing.",
    "timezone": "Asia/Dhaka",
    "cases": [
        { "name": "left: under a minute (23:59:30 on the due day in Dhaka)", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T23:59:30+06:00", "expected": { "label": "less than a minute left", "overdue": false } },
        { "name": "left: 1 minute, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T23:59:00+06:00", "expected": { "label": "1 minute left", "overdue": false } },
        { "name": "left: 45 minutes", "due_date": "2026-10-24", "status": "in_progress", "now": "2026-10-24T23:15:00+06:00", "expected": { "label": "45 minutes left", "overdue": false } },
        { "name": "left: 59 minutes 59 seconds floors to 59 minutes", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T23:00:01+06:00", "expected": { "label": "59 minutes left", "overdue": false } },
        { "name": "left: exactly 1 hour, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T23:00:00+06:00", "expected": { "label": "1 hour left", "overdue": false } },
        { "name": "left: 6 hours", "due_date": "2026-10-24", "status": "in_review", "now": "2026-10-24T18:00:00+06:00", "expected": { "label": "6 hours left", "overdue": false } },
        { "name": "left: 23 hours 59 minutes floors to 23 hours", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T00:01:00+06:00", "expected": { "label": "23 hours left", "overdue": false } },
        { "name": "date-only due date: due today, at 09:00 it is still 15 hours left, not overdue", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T09:00:00+06:00", "expected": { "label": "15 hours left", "overdue": false } },
        { "name": "left: exactly 24 hours is 1 day, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-24T00:00:00+06:00", "expected": { "label": "1 day left", "overdue": false } },
        { "name": "left: 5 days", "due_date": "2026-10-24", "status": "backlog", "now": "2026-10-20T00:00:00+06:00", "expected": { "label": "5 days left", "overdue": false } },
        { "name": "left: 6 days 23:59:59 is still 6 days (6 -> 7 boundary)", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-18T00:00:01+06:00", "expected": { "label": "6 days left", "overdue": false } },
        { "name": "left: exactly 7 days is 1 week, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-18T00:00:00+06:00", "expected": { "label": "1 week left", "overdue": false } },
        { "name": "left: 14 days is 2 weeks", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-11T00:00:00+06:00", "expected": { "label": "2 weeks left", "overdue": false } },
        { "name": "left: 28 days floors to 4 weeks", "due_date": "2026-10-24", "status": "todo", "now": "2026-09-27T00:00:00+06:00", "expected": { "label": "4 weeks left", "overdue": false } },
        { "name": "left: 29 days 23:59:59 is still 4 weeks (29 -> 30 boundary)", "due_date": "2026-10-24", "status": "todo", "now": "2026-09-25T00:00:01+06:00", "expected": { "label": "4 weeks left", "overdue": false } },
        { "name": "left: exactly 30 days is 1 month, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-09-25T00:00:00+06:00", "expected": { "label": "1 month left", "overdue": false } },
        { "name": "left: 60 days is 2 months", "due_date": "2026-10-24", "status": "todo", "now": "2026-08-26T00:00:00+06:00", "expected": { "label": "2 months left", "overdue": false } },
        { "name": "overdue: exactly at the deadline (00:00:00 the next day in Dhaka)", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-25T00:00:00+06:00", "expected": { "label": "just overdue", "overdue": true } },
