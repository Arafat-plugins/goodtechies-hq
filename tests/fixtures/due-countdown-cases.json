        { "name": "overdue: 1 hour, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-25T01:00:00+06:00", "expected": { "label": "1 hour overdue", "overdue": true } },
        { "name": "overdue: 3 hours", "due_date": "2026-10-24", "status": "waiting", "now": "2026-10-25T03:00:00+06:00", "expected": { "label": "3 hours overdue", "overdue": true } },
        { "name": "overdue: 1 day, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-26T00:00:00+06:00", "expected": { "label": "1 day overdue", "overdue": true } },
        { "name": "overdue: 2 days", "due_date": "2026-10-24", "status": "in_review", "now": "2026-10-27T05:00:00+06:00", "expected": { "label": "2 days overdue", "overdue": true } },
        { "name": "overdue: 6 days 23 hours is still 6 days (6 -> 7 boundary)", "due_date": "2026-10-24", "status": "todo", "now": "2026-10-31T23:00:00+06:00", "expected": { "label": "6 days overdue", "overdue": true } },
        { "name": "overdue: exactly 7 days is 1 week, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-11-01T00:00:00+06:00", "expected": { "label": "1 week overdue", "overdue": true } },
        { "name": "overdue: 28 days floors to 4 weeks", "due_date": "2026-10-24", "status": "todo", "now": "2026-11-22T00:00:00+06:00", "expected": { "label": "4 weeks overdue", "overdue": true } },
        { "name": "overdue: 29 days 23 hours is still 4 weeks (29 -> 30 boundary)", "due_date": "2026-10-24", "status": "todo", "now": "2026-11-23T23:00:00+06:00", "expected": { "label": "4 weeks overdue", "overdue": true } },
        { "name": "overdue: exactly 30 days is 1 month, singular", "due_date": "2026-10-24", "status": "todo", "now": "2026-11-24T00:00:00+06:00", "expected": { "label": "1 month overdue", "overdue": true } },
        { "name": "overdue: 60 days is 2 months", "due_date": "2026-10-24", "status": "backlog", "now": "2026-12-24T00:00:00+06:00", "expected": { "label": "2 months overdue", "overdue": true } },
        { "name": "no due date renders nothing and is never overdue", "due_date": null, "status": "todo", "now": "2026-10-25T12:00:00+06:00", "expected": { "label": null, "overdue": false } },
        { "name": "completed and past due renders nothing and is not overdue", "due_date": "2026-10-24", "status": "completed", "now": "2026-10-30T12:00:00+06:00", "expected": { "label": null, "overdue": false } },
        { "name": "completed and not yet due renders nothing", "due_date": "2026-10-24", "status": "completed", "now": "2026-10-20T12:00:00+06:00", "expected": { "label": null, "overdue": false } },
        { "name": "cancelled and past due renders nothing and is not overdue", "due_date": "2026-10-24", "status": "cancelled", "now": "2026-10-30T12:00:00+06:00", "expected": { "label": null, "overdue": false } }
    ]
}
