APP_NAME="goodERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime connection (pgsql): hq_app, the least-privileged role the app runs as.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=goodtechies_hq
DB_USERNAME=hq_app
DB_PASSWORD=
DB_TIMEZONE=Asia/Dhaka

# Schema owner (pgsql_migrator): hq_migrator. Migrations run with --database=pgsql_migrator.
DB_MIGRATOR_USERNAME=hq_migrator
DB_MIGRATOR_PASSWORD=

# Read-only connection (pgsql_ro): hq_ro.
DB_RO_USERNAME=hq_ro
DB_RO_PASSWORD=

# Seed data (TeamSeeder). SEED_PASSWORD is required; the 2FA secret (base32) is used only in local/testing.
SEED_PASSWORD=
SEED_TWO_FACTOR_SECRET=
SEED_SHAHADAT_EMAIL=shahadat@goodtechies.test
SEED_FARUK_EMAIL=faruk@goodtechies.test
SEED_TAPU_EMAIL=tapu@goodtechies.test
SEED_YASEEN_EMAIL=yaseen@goodtechies.test
SEED_ACCOUNTANT_EMAIL=accountant@goodtechies.test

# Two-factor authentication for local development only.
# Admins and Accountants must pass a TOTP code at sign-in. Set this to false on your own
# machine to sign in with just a password while building and testing. Anything other than an
# explicit false/0/off/no — including a blank or misspelt value — leaves 2FA switched ON.
# It changes nothing in the database: existing secrets, confirmations and recovery codes are
# kept, so setting it back to true restores the code prompt exactly as it was.
# THIS DOES NOTHING IN PRODUCTION. When APP_ENV=production the application ignores this key
# entirely and always enforces two-factor authentication.
AUTH_TWO_FACTOR_ENFORCED=true

SESSION_DRIVER=database
SESSION_LIFETIME=2880
# "Remember me" (on by default): stay signed in until signing out. 400 days in minutes (12-89).
REMEMBER_LIFETIME=576000
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Realtime (Phase 6: Laravel Reverb). ---
#
# Two keys, set together: BROADCAST_CONNECTION is how the server sends, VITE_REALTIME is
# whether the browser listens. VITE_* is baked in by `npm run build`, so changing it needs a
# rebuild and not a `config:clear`. Anything but the exact string `reverb` is polling.
#
# To develop against a real socket: set both to `reverb`, fill the three credentials with any
# values, and run `php artisan reverb:start` beside `php artisan serve`.
BROADCAST_CONNECTION=log
VITE_REALTIME=polling

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Which Google Calendar driver to run (Phase 7, master prompt Part D §12 and §20).
# `manual` is the default and is always available: the organizer opens Google's instant-meeting
# flow, pastes the link back, and the application needs no Google credentials at all.
# Not a `settings` key on purpose — it changes which classes are bound at boot, so it cannot
# switch at runtime; Admin → Settings shows it read-only.
# `api` is the second driver Part D describes and is NOT BUILT: it is blocked on the Workspace
# decision in PROGRESS.md GATE A question 3 (per-organizer OAuth, or a service account with
# domain-wide delegation — a plain service account cannot create Meet links). Setting it today
# throws at boot rather than falling back to `manual`, so a misconfigured deployment finds out
# immediately instead of running for a week with no Meet links.
GOOGLE_CALENDAR_DRIVER=manual

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset emails. smtp with the domain's own mailbox (e.g. Hostinger: smtp.hostinger.com, 465, MAIL_SCHEME=smtps) lands best; MAIL_MAILER=sendmail uses the server's local MTA (needs postfix + a PTR record, or Gmail rejects it); log writes the mail to storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@goodtechies.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup): encrypted daily database dumps, verified weekly.
# Put the bucket in a different provider account or region from AWS_BUCKET.
# BACKUP_ARCHIVE_PASSWORD is required to restore: store a copy outside the server.
BACKUP_DISK=backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Push notifications (Profile → Notifications on this device). deploy/deploy.sh fills the keys
# once with `php artisan push:vapid --write`; never replace them on a live server.
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
