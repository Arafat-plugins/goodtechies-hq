APP_NAME="GoodTechies HQ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime connection (pgsql): hq_app, the least-privileged role the app runs as.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=goodtechies_hq
DB_USERNAME=hq_app
DB_PASSWORD=
DB_TIMEZONE=Asia/Dhaka

# Schema owner (pgsql_migrator): hq_migrator. Migrations run with --database=pgsql_migrator.
DB_MIGRATOR_USERNAME=hq_migrator
DB_MIGRATOR_PASSWORD=

# Read-only connection (pgsql_ro): hq_ro.
DB_RO_USERNAME=hq_ro
DB_RO_PASSWORD=

# Seed data (TeamSeeder). SEED_PASSWORD is required; the 2FA secret (base32) is used only in local/testing.
SEED_PASSWORD=
SEED_TWO_FACTOR_SECRET=
SEED_SHAHADAT_EMAIL=shahadat@goodtechies.test
SEED_FARUK_EMAIL=faruk@goodtechies.test
SEED_TAPU_EMAIL=tapu@goodtechies.test
SEED_YASEEN_EMAIL=yaseen@goodtechies.test
SEED_ACCOUNTANT_EMAIL=accountant@goodtechies.test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup): encrypted daily database dumps, verified weekly.
# Put the bucket in a different provider account or region from AWS_BUCKET.
# BACKUP_ARCHIVE_PASSWORD is required to restore: store a copy outside the server.
BACKUP_DISK=backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
